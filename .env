# ─── RAPIN — Variáveis de Ambiente ───────────────────────────────────────────
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commite o arquivo .env com credenciais reais.

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# URI de conexão com o MongoDB
# Local:  mongodb://127.0.0.1:27017/rapin
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/rapin
#MONGO_URI=mongodb://laecio8andrade_db_user:n89CjChCV7PWo11L@ac-uk9hcbx-shard-00-00.fdxsdfm.mongodb.net:27017,ac-uk9hcbx-shard-00-01.fdxsdfm.mongodb.net:27017,ac-uk9hcbx-shard-00-02.fdxsdfm.mongodb.net:27017/?ssl=true&replicaSet=atlas-lts1za-shard-0&authSource=admin&appName=Rapin
MONGO_URI=mongodb+srv://laecio8andrade_db_user:n89CjChCV7PWo11L@rapin.fdxsdfm.mongodb.net/?appName=Rapin

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Chave secreta para assinar os tokens JWT — use uma string longa e aleatória em produção!
# Gere uma com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=rapin_troque_em_producao

# Tempo de expiração do token (ex.: 7d, 24h, 30m)
JWT_EXPIRES=7d

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Porta HTTP do servidor Express
PORT=3000
